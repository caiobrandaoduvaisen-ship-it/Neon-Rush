{
  "name": "neonrush3d-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor do Neon Rush 3D: contas, cargos, loja, chat, mensagens, moderação e ranking.",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/migrate.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
